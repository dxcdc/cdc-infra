# Configurações do ERPNext

# O nome ou domínio do seu site (Ex: erp.cdc.org.br ou erpnext.local)
# Importante: Mesmo que use localmente, dê um nome sem espaços.
FRAPPE_SITE_NAME=erp.cdc.org.br

# Senha do Banco de Dados MariaDB (não use senhas fracas em produção)
DB_PASSWORD=ong_mariadb_pass_seguro123

# Senha que será configurada para o usuário 'Administrator' do ERPNext
ADMIN_PASSWORD=ong_admin_pass_seguro123
